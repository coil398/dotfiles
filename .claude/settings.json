  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/dotfiles-session-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr create *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr edit *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-opencode-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-codex-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-devin-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/shellcheck-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/ai-lint-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"deny\",\"message\":\"他人の Artifact は auto mode では読めない。中身はユーザーに貼ってもらうか、Slack や Figma など元の資料から取ること\"}}}'"
          }
        ]
      }
    ]
  },
