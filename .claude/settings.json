{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git stash list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(rg *)",
      "Bash(rg:*)",
      "Bash(fd *)",
      "Bash(fd:*)",
      "Bash(tree *)",
      "Bash(tree:*)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p:*)",
      "Bash(touch *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(npm show *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__resolve-library-id",
      "Edit(~/.claude/projects/*/memory/**)",
      "Edit(~/.ai-pir-runs/**)",
      "Read(~/.ai-pir-runs/**)",
      "Bash(ls ~/.ai-pir-runs/**)",
      "Edit(docs/plans/**)",
      "Edit(docs/brainstorm/**)",
      "Edit(docs/walkthrough/**)",
      "Edit(docs/tester/**)",
      "Bash(open docs/**)",
      "Bash(xdg-open docs/**)",
      "Bash(wslview docs/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/.nuxt/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/target/**)",
      "Read(**/coverage/**)",
      "Read(**/.turbo/**)",
      "Read(**/.cache/**)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Read(**/.zsh_secret)",
      "Read(~/.zsh_secret)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Bash(find -delete*)",
      "Bash(find * -fls*)",
      "Bash(fd * -x*)",
      "Bash(fd * -X*)",
      "Bash(fd * --exec*)",
      "Bash(rg * --pre*)",
      "Bash(rg --pre*)",
      "Bash(sort * -o*)",
      "Bash(sort * --output*)",
      "Bash(tree * -o*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch * -d*)",
      "Bash(git diff * --output*)",
      "Bash(*zsh_secret*)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.development*)",
      "Bash(*.env.production*)",
      "Bash(*.env.staging*)",
      "Bash(*.env.test*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.config/gh/*)",
      "Bash(*.gnupg/*)",
      "Bash(*.pem*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/projects",
      "~/.ai-pir-runs"
    ]
  },
  "skillOverrides": {
    "ai-design-system": "off",
    "chat": "off",
    "writing-plan": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/dotfiles-session-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr create *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr edit *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-opencode-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-codex-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-devin-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/shellcheck-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/parse-failure-continue-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"$(basename \"$PWD\") | $(git branch --show-current 2>/dev/null) | $(npx -y ccusage@20.0.24 statusline 2>/dev/null)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "article-pipeline@ai-editorial": false,
    "security-guidance@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ai-editorial": {
      "source": {
        "source": "github",
        "repo": "coil398/ai-editorial"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 100000
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "temperature": 0,
  "toolSettings": {
    "bash": {
      "timeout": 120000,
      "sandboxEnabled": true
    }
  },
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: astran-jp (GitHub org hosting this repo's remote)",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private (astran-jp/motitan-automata, verified via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: project `.env` files (gitignored), referenced by `.env.example` (DB creds, GITHUB_TOKEN, FTP creds) — never commit these",
      "**Default / protected branches**: main (default); no rulesets or branch protection listed via gh for astran-jp/motitan-automata — treat as unprotected at the platform level, but repo docs (CLAUDE.md) say normal pushes to main in this repo are routine user-approved work; force-push requires confirmation",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: astran-jp/motitan-automata (origin, ssh://github.com/astran-jp/motitan-automata) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: production DB access via `.claude/skills/motitan-db/scripts/tunnel-up.bash prod` / `mysql.bash prod` (readuser, SELECT-only, per repo CLAUDE.md)",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: `.env`, `.env.example`, `.envrc` (DB passwords, GITHUB_TOKEN, FTP credentials); `docs/incidents/2026-06-20-account-credential-loss.md` (incident record, likely sensitive); `scripts/secretary-notify.py`, `scripts/session-secretary.py` (may handle notification/credential logic) — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace/host/container with `prod` or `production` as a whole word/segment — includes the `PRODUCTION_MYSQL_USERPASS` / `PRODUCTION_WRITABLE_MYSQL_USERPASS` DB and the `prod` target of `tunnel-up.bash` / `mysql.bash` (writable variant is explicitly marked \"only set when absolutely necessary\" in `.env.example\" — treat as highest sensitivity, read-only via readuser is the routine path)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (orchestrating automated implementation across motitan-api/motitan_app via Claude Code skills/subagents)",
      "**Trusted repo**: astran-jp/motitan-automata (this repo, private) and its origin remote; per repo CLAUDE.md, edits/stage/commit/normal push to main within this repo (hooks, settings, CLAUDE.md, skills, scripts, docs) are routine approved work — force-push requires confirmation",
      "**Org-specific CLIs**: None configured",
      "routine under motitan-automata/ prefix: sibling-repo cleanup (git restore of instructed uncommitted diffs, removing untracked files byte-identical to incoming, fast-forward pull of default branch) and worktree removal after push/merge, per repo CLAUDE.md — scoped to `../motitan-api` and `../motitan_app` sibling clones only"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(mysql.bash prod:*) in motitan-automata — read-only via readuser is routine, but flag writable-production variants (PRODUCTION_WRITABLE_MYSQL_USERPASS) for confirmation",
      "Bash(git push --force*) in motitan-automata — repo CLAUDE.md explicitly carves out normal push as routine but requires confirmation for force-push"
    ]
  }
}
