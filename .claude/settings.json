{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git stash list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(rg *)",
      "Bash(rg:*)",
      "Bash(fd *)",
      "Bash(fd:*)",
      "Bash(tree *)",
      "Bash(tree:*)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p:*)",
      "Bash(touch *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(npm show *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__resolve-library-id",
      "Edit(~/.claude/projects/*/memory/**)",
      "Edit(~/.ai-pir-runs/**)",
      "Read(~/.ai-pir-runs/**)",
      "Bash(ls ~/.ai-pir-runs/**)",
      "Edit(docs/plans/**)",
      "Edit(docs/brainstorm/**)",
      "Edit(docs/walkthrough/**)",
      "Edit(docs/tester/**)",
      "Bash(open docs/**)",
      "Bash(xdg-open docs/**)",
      "Bash(wslview docs/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/.nuxt/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/target/**)",
      "Read(**/coverage/**)",
      "Read(**/.turbo/**)",
      "Read(**/.cache/**)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Read(**/.zsh_secret)",
      "Read(~/.zsh_secret)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(find -delete*)",
      "Bash(find * -fls*)",
      "Bash(fd * -x*)",
      "Bash(fd * -X*)",
      "Bash(fd * --exec*)",
      "Bash(rg * --pre*)",
      "Bash(rg --pre*)",
      "Bash(sort * -o*)",
      "Bash(sort * --output*)",
      "Bash(tree * -o*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch * -d*)",
      "Bash(git diff * --output*)",
      "Bash(*zsh_secret*)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env.*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/projects",
      "~/.ai-pir-runs"
    ]
  },
  "skillOverrides": {
    "ai-design-system": "off",
    "chat": "off",
    "writing-plan": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/dotfiles-session-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr create *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr edit *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-opencode-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-codex-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-devin-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/shellcheck-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/parse-failure-continue-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"$(basename \"$PWD\") | $(git branch --show-current 2>/dev/null) | $(npx -y ccusage@20.0.24 statusline 2>/dev/null)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "article-pipeline@ai-editorial": false,
    "security-guidance@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ai-editorial": {
      "source": {
        "source": "github",
        "repo": "coil398/ai-editorial"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "temperature": 0,
  "toolSettings": {
    "bash": {
      "timeout": 120000,
      "sandboxEnabled": true
    }
  }
}
