{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git stash list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(diff *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(rg *)",
      "Bash(rg:*)",
      "Bash(fd *)",
      "Bash(fd:*)",
      "Bash(tree *)",
      "Bash(tree:*)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p:*)",
      "Bash(touch *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(npm show *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__resolve-library-id",
      "Edit(~/.claude/projects/*/memory/**)",
      "Edit(~/.ai-pir-runs/**)",
      "Read(~/.ai-pir-runs/**)",
      "Bash(ls ~/.ai-pir-runs/**)",
      "Edit(docs/plans/**)",
      "Edit(docs/brainstorm/**)",
      "Edit(docs/walkthrough/**)",
      "Edit(docs/tester/**)",
      "Bash(open docs/**)",
      "Bash(xdg-open docs/**)",
      "Bash(wslview docs/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/.nuxt/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/target/**)",
      "Read(**/coverage/**)",
      "Read(**/.turbo/**)",
      "Read(**/.cache/**)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Read(**/.zsh_secret)",
      "Read(~/.zsh_secret)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Bash(find -delete*)",
      "Bash(find * -fls*)",
      "Bash(fd * -x*)",
      "Bash(fd * -X*)",
      "Bash(fd * --exec*)",
      "Bash(rg * --pre*)",
      "Bash(rg --pre*)",
      "Bash(sort * -o*)",
      "Bash(sort * --output*)",
      "Bash(tree * -o*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch * -d*)",
      "Bash(git diff * --output*)",
      "Bash(*zsh_secret*)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.development*)",
      "Bash(*.env.production*)",
      "Bash(*.env.staging*)",
      "Bash(*.env.test*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.config/gh/*)",
      "Bash(*.gnupg/*)",
      "Bash(*.pem*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/projects",
      "~/.ai-pir-runs"
    ]
  },
  "skillOverrides": {
    "ai-design-system": "off",
    "chat": "off",
    "writing-plan": "off",
    "agent-skill-migrate": "off",
    "directed-task-execution": "off",
    "overlay-audit": "off",
    "sentinel-review": "off",
    "wsl-windows": "off",
    "python-toolchain": "off",
    "agent-cli": "off",
    "design-review": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/dotfiles-session-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr create *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/foreign-project-name-guard.sh",
            "if": "Bash(gh pr edit *)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-opencode-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-codex-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/sync-devin-hook.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/lib/shellcheck-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/lib/jev-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"$(basename \"$PWD\") | $(git branch --show-current 2>/dev/null) | $(npx -y ccusage@20.0.24 statusline 2>/dev/null)\"",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "article-pipeline@ai-editorial": false,
    "security-guidance@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true,
    "private@private-skills": true,
    "session-brief@claude-session-brief": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ai-editorial": {
      "source": {
        "source": "github",
        "repo": "coil398/ai-editorial"
      }
    },
    "private-skills": {
      "source": {
        "source": "directory",
        "path": "/home/coil398/private-skills"
      }
    },
    "claude-session-brief": {
      "source": {
        "source": "github",
        "repo": "coil398/claude-session-brief"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 100000
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(mysql.bash prod:*) in orchestrator-hub — read-only via readuser is routine, but flag writable-production variants (PRODUCTION_WRITABLE_MYSQL_USERPASS) for confirmation",
      "Bash(git push --force*) in orchestrator-hub — repo CLAUDE.md explicitly carves out normal push as routine but requires confirmation for force-push",
      "Bash(mysql.bash prod:*) in orchestrator-hub — read-only via readuser is routine, but writable-production variants (PRODUCTION_WRITABLE_MYSQL_USERPASS) require confirmation",
      "Bash(git push --force*) in orchestrator-hub — normal push is routine but force-push requires confirmation"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured — commands seen (az, gcloud) are ad hoc CLI usage, not corroborated as deploy targets for this project",
      "**Repository visibility**: private (example-org/orchestrator-hub, via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured — repo uses local .env files (gitignored) for DB/FTP credentials; no secrets manager referenced",
      "**Default / protected branches**: main (default); no rulesets or protected branches listed by gh — repo CLAUDE.md permits normal push to main as routine but requires confirmation for force-push",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (example-org/orchestrator-hub) and its origin remote only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: .env, .env.example, .envrc (local DB/FTP credentials incl. PRODUCTION_WRITABLE_MYSQL_USERPASS, MANUAL_FTP_*); docs/incidents/2026-06-20-account-credential-loss.md; scripts/secretary-notify.py and scripts/session-secretary.py (handle notification/secretary data) — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: PRODUCTION_* env vars and prod DB access (mysql.bash prod — readuser/SELECT only is routine per repo CLAUDE.md; writable-production variant requires confirmation); any namespace/host carrying prod or production as a whole word/segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic (k8s namespaces seen: obsr-test, account, obsr-test-1 — none are prod-named)",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries prod or production as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Unity/Go orchestration via orchestrator-hub)",
      "**Trusted repo**: example-org/orchestrator-hub (private) and its origin remote; sibling repos ../app-api and ../app-client are referenced by project docs but per README no files are to be added/changed there by this project — treat as out of scope for write operations",
      "**Org-specific CLIs**: None configured",
      "routine under orchestrator-hub/ prefix: editing .claude/hooks/, .claude/settings.json, CLAUDE.md, skills, scripts, docs, and committing/pushing to main is user-approved routine work per repo CLAUDE.md; force-push requires confirmation"
    ]
  },
  "temperature": 0,
  "toolSettings": {
    "bash": {
      "timeout": 120000,
      "sandboxEnabled": true
    }
  }
}
