#!/bin/sh
# shellcheck disable=SC1007

# project Unity 用の専用 Codex 入口。
# この launcher を明示したセッションだけが project profile を選択する。
set -eu

error() {
    printf '[codex-project] error: %s\n' "$*" >&2
}

if ! command -v git >/dev/null 2>&1; then
    error 'git is required'
    exit 1
fi

if ! AUTOMATA_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$AUTOMATA_ROOT" ]; then
    error 'start this launcher from inside a Git worktree'
    exit 1
fi

if ! AUTOMATA_ROOT="$(CDPATH= cd -P "$AUTOMATA_ROOT" 2>/dev/null && pwd -P)"; then
    error 'cannot resolve the Git worktree root'
    exit 1
fi

if [ "$(basename "$AUTOMATA_ROOT")" != orchestrator-hub ]; then
    error "launcher is restricted to a orchestrator-hub worktree: $AUTOMATA_ROOT"
    exit 1
fi

if [ ! -f "$AUTOMATA_ROOT/AGENTS.md" ]; then
    error "orchestrator-hub AGENTS.md is missing: $AUTOMATA_ROOT/AGENTS.md"
    exit 1
fi

if [ ! -f "$AUTOMATA_ROOT/scripts/unity-cli.sh" ]; then
    error "automata Unity wrapper is missing: $AUTOMATA_ROOT/scripts/unity-cli.sh"
    exit 1
fi

if ! APP_ROOT="$(CDPATH= cd -P "$AUTOMATA_ROOT/../app-client" 2>/dev/null && pwd -P)"; then
    error "app-client sibling repository is missing: $AUTOMATA_ROOT/../app-client"
    exit 1
fi

if [ ! -f "$APP_ROOT/AGENTS.md" ]; then
    error "app-client AGENTS.md is missing: $APP_ROOT/AGENTS.md"
    exit 1
fi

if ! command -v codex >/dev/null 2>&1; then
    error 'codex is required'
    exit 1
fi

# Keep the dedicated profile authoritative when this entrypoint is used.
for arg in "$@"; do
    case "$arg" in
        -p|-p?*|--profile|--profile=*)
            error 'profile override is not allowed; codex-project always uses -p project'
            exit 2
            ;;
        -s|-s?*|--sandbox|--sandbox=*|-a|-a?*|--ask-for-approval|--ask-for-approval=*|-c|-c?*|--config|--config=*|--approve-for-me|--dangerously-bypass-approvals-and-sandbox)
            error 'permission and config overrides are not allowed; codex-project keeps the project profile authoritative'
            exit 2
            ;;
    esac
done

exec codex -p project -C "$AUTOMATA_ROOT" --add-dir "$APP_ROOT" "$@"
